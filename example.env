NEXT_PUBLIC_MODE='dev'
NEXT_PUBLIC_DEV_API_URL='http://localhost:3000'
NEXT_PUBLIC_PROD_API_URL='same-origin'
# Set INTERNAL_API_URL to the private backend origin at runtime in prod mode.
# It is not a public browser value and is not needed for an image build.
NEXT_PUBLIC_SITE_URL='https://24-7labs.com'
NEXT_PUBLIC_CHECKOUT_ENABLED='false'
# Public browser values required only when checkout is enabled. These are not
# Authorize.Net transaction credentials; never place the Transaction Key here.
NEXT_PUBLIC_AUTHORIZE_NET_ENVIRONMENT=''
NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID=''
NEXT_PUBLIC_AUTHORIZE_NET_CLIENT_KEY=''
