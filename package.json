{
	"name": "sample-frontend",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.23.2 <23",
		"npm": "10.9.8"
	},
	"packageManager": "npm@10.9.8",
	"scripts": {
		"lint": "eslint",
		"build": "next build",
		"verify:client-config": "node scripts/verify-client-config.mjs",
		"verify:consent-manifest": "node scripts/verify-consent-manifest.mjs",
		"start": "next start",
		"dev": "next dev -p 4000",
		"format": "prettier --write .",
		"format:check": "node scripts/check-format.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"audit": "npm audit --audit-level=high",
		"audit:prod": "npm audit --omit=dev --audit-level=high",
		"ci": "npm run format:check && npm run verify:consent-manifest && npm run lint && npm test && npm run build && npm run verify:client-config"
	},
	"dependencies": {
		"lucide-react": "^0.577.0",
		"next": "16.3.0",
		"next-intl": "4.13.6",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-signature-canvas": "^1.1.0-alpha.2",
		"sanitize-html": "2.17.6"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@tailwindcss/typography": "^0.5.19",
		"eslint": "^9",
		"eslint-config-next": "16.3.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4",
		"vitest": "4.1.10"
	}
}
